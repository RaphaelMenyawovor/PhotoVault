// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  BANNED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum AlbumRole {
  VIEWER
  EDITOR
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  password          String
  role              Role               @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  photos            Photo[]
  albums            Album[]
  sharedAlbums      SharedAlbum[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]

  resetToken       String?
  resetTokenExpiry DateTime?

  googleId String? @unique
  avatar   String?

  @@map("users")
}

model Photo {
  id          String     @id @default(uuid())
  title       String
  description String?
  url         String
  publicId    String     @unique // Cloudinary public_id
  visibility  Visibility @default(PUBLIC)
  userId      String
  albumId     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tags        String[]
  deletedAt   DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  album Album? @relation(fields: [albumId], references: [id])

  @@map("photos")
}

model Album {
  id        String   @id @default(uuid())
  title     String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos     Photo[]
  sharedWith SharedAlbum[]
  password   String?

  magicLinkToken     String?   @unique
  magicLinkExpiresAt DateTime?
  deletedAt          DateTime?

  @@map("albums")
}

model SharedAlbum {
  albumId   String
  userId    String
  role      AlbumRole @default(VIEWER)
  createdAt DateTime  @default(now())

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([albumId, userId])
  @@map("shared_albums")
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  keys      Json // Stores { p256dh, auth }
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String // e.g., "USER_BAN", "ROLE_UPDATE"
  details   Json? // { targetUserId, oldValue, newValue, reason }
  adminId   String
  ipAddress String?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@map("audit_logs")
}
