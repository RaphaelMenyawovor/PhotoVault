{
  "name": "photovault",
  "version": "1.1.0",
  "private": true,
  "description": "A secure photo storage application backend.",
  "main": "server.js",
  "scripts": {
    "start": "node dist/server.js",
    "lint": "eslint .",
    "build": "npx prisma generate && tsc",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'tsx' src/server.ts | pino-pretty -t \"ts\" -l \"sev\" -m \"msg\" --ignore \"pid,hostname\"",
    "p:gen": "prisma generate",
    "p:mig": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaphaelMenyawovor/PhotoVault.git"
  },
  "keywords": [],
  "author": "Raphael Menyawovor",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/RaphaelMenyawovor/PhotoVault/issues"
  },
  "homepage": "https://github.com/RaphaelMenyawovor/PhotoVault#readme",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.2.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.3.0",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "^2.35.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.11",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "redis": "^5.10.0",
    "redis-cli": "^2.1.2",
    "resend": "^6.9.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "ws": "^8.19.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "bufferutil": "^4.1.0",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript-eslint": "^8.51.0"
  }
}
